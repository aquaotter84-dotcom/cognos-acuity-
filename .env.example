# ---------------------------------------------------------------------------
# COGNOS environment. On Vercel set these in Project -> Settings -> Environment
# Variables. Never commit real values; none of these reach the browser.
# ---------------------------------------------------------------------------

# --- Model: BluesMinds (required) ---
# Create a key at https://api.bluesminds.com/console -> Tokens (starts with sk-)
BLUESMINDS_API_KEY=sk-...
# Optional. OpenAI-compatible base URL. Default: https://api.bluesminds.com/v1
BLUESMINDS_API_URL=https://api.bluesminds.com/v1
# Optional. Defaults to gpt-4o-mini. gpt_5_4 is REFUSED by the app (503s on this account).
COGNOS_MODEL=gpt-4o-mini
# Optional cheaper model for Observer/Strategist/Critic/memory. Defaults to COGNOS_MODEL.
COGNOS_FAST_MODEL=gpt-4o-mini
# Optional. One logical deadline for an upstream call INCLUDING retries.
# Clamped to 1–180 seconds; default 60000.
COGNOS_LLM_TIMEOUT_MS=60000
# Optional. Retry transient network/408/429/5xx gateway failures with the exact
# same prompt and model. Clamped to 0–2; default 1. Retries stay inside the
# logical deadline above, and every physical attempt is recorded in telemetry.
COGNOS_LLM_MAX_RETRIES=1
# Optional transport-only tuning. Leave blank unless the configured compatible
# gateway supports these Chat Completions fields. They never change prompts or
# models. OpenAI supports auto/default/flex/scale/priority/fast service tiers.
COGNOS_LLM_SERVICE_TIER=
# Optional provider routing key for exact-prefix prompt caching (max 64 chars).
# This is an identifier, not a credential; never put sensitive data in it.
COGNOS_PROMPT_CACHE_KEY=

# --- Database: Neon (required for persistence) ---
# Neon dashboard -> Connection string -> "Pooled connection".
# MUST be the pooled postgres:// URL containing "-pooler". The REST https://
# variant is rejected by the app (it hangs ~16s per query).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cognos?sslmode=require

# --- Web search (optional) ---
# With no key the council falls back to DuckDuckGo (keyless).
TAVILY_API_KEY=
COGNOS_SEARCH_ENABLED=true

# --- Phase 14/15 subsystems (all optional; defaults shown) ---
# Event ledger kill switch. false = no knowledge_events rows are written at all.
COGNOS_LEDGER_ENABLED=true
# Coherence monitor: one extra cheap-model call per turn that measures the draft
# against stored beliefs. false = the stage is skipped.
COGNOS_COHERENCE_ENABLED=true
# Reasoning telemetry: one record per run (latency, model, tokens, cost, veto,
# failures). false = nothing is written to telemetry_runs.
COGNOS_TELEMETRY_ENABLED=true
# Adaptive orchestrator mode. v1 forces "observe": "auto" is recorded as
# requested and refused (law phase15.observe_only). No live strategy switches.
COGNOS_ADAPTIVE_MODE=observe

# --- Phase 22 bounded context window + structured memory (optional) ---
# The context assembler admits a larger, deterministic input window before the
# answer seats run. It never asks the provider to guess how much context fits.
# Values are clamped server-side; defaults are shown below.
COGNOS_CONTEXT_MAX_TOKENS=16000
COGNOS_CONTEXT_OUTPUT_RESERVE_TOKENS=2048
COGNOS_CONTEXT_MAX_HISTORY_MESSAGES=40
COGNOS_CONTEXT_HISTORY_TOKENS=4500
COGNOS_CONTEXT_SUMMARY_TOKENS=500
COGNOS_CONTEXT_MEMORY_TOKENS=2000
COGNOS_CONTEXT_SOURCE_TOKENS=4800
COGNOS_CONTEXT_SEARCH_TOKENS=1800
COGNOS_CONTEXT_WORKSPACE_TOKENS=450
COGNOS_CONTEXT_USER_TOKENS=2600
COGNOS_CONTEXT_OVERHEAD_TOKENS=1600
COGNOS_CONTEXT_GRAPH_TOKENS=1200

# --- Phase 23 trust-annotated knowledge graph ("atlas"; optional) ---
# The engine stitches sessions, sources, and intents into a user-controlled,
# append-only graph. The turn consults it before drafting (consult switch) and
# projects approved exchanges back after governance (project switch); curation
# (pin/fork/revise/retire/trust) stays user-controlled. Max nodes loaded per
# turn is clamped 0-32 server-side; 0 consults nothing while still projecting.
COGNOS_GRAPH_ENABLED=true
COGNOS_GRAPH_CONSULT_ENABLED=true
COGNOS_GRAPH_PROJECT_ENABLED=true
COGNOS_GRAPH_MAX_NODES_PER_TURN=8

# --- Phase 17/18 sources, images, research + bounded agent (optional) ---
# Document/link/image ingestion. false removes source reads from council context
# and disables the source API without deleting immutable snapshots already stored.
COGNOS_SOURCES_ENABLED=true
# Raw upload/fetch and extracted-text safety limits. Server clamps out-of-range
# values; the browser upload surface currently caps files at 6 MB as well.
COGNOS_SOURCE_MAX_BYTES=4000000
COGNOS_SOURCE_MAX_TEXT_CHARS=750000
COGNOS_LINK_MAX_BYTES=2000000
COGNOS_LINK_TIMEOUT_MS=12000
# Phase 18 images: PNG/JPEG/WebP originals are always parsed and hashed. The
# Image Desk vision reading (region-boxed transcript, injection screening) is
# on unless disabled; COGNOS_IMAGE_MODEL defaults to the primary model.
COGNOS_IMAGE_MAX_BYTES=4000000
COGNOS_IMAGE_VISION_ENABLED=true
COGNOS_IMAGE_MODEL=
# Phase 18 research mode: proposes a finite read-only plan that executes only
# after the user approves each step (recorded in agent_approvals).
COGNOS_RESEARCH_ENABLED=true
COGNOS_RESEARCH_MAX_STEPS=3
# Agent mode remains explicit per turn (off / observe / read_only / research).
# This switch disables the non-off modes. Phase 17/18 have no autonomous
# write-capable tools and research never releases an answer by itself.
COGNOS_AGENT_ENABLED=true

# --- Optional access gate ---
# Unset = no gate, app opens straight to chat. Set = visit /gate?key=<value> once.
COGNOS_RUNTIME_SECRET=

# Local only. Vercel sets its own port.
PORT=3000

# --- Phase 19 autonomy (durable residents + goals) ---
# Toggle. Unset or false = the loop stays frozen: nothing wakes, no goal runs,
# no notice is generated. Phase 19 is OFF until an operator enables a rung.
COGNOS_AUTONOMY_ENABLED=false
# Outbox mode:
#   shadow / unset -> effects are judged and recorded as would_release, nothing happens
#   dry_run        -> judged, and the EXACT request is built and recorded on the
#                     row (destination, header names, body digest) — still nothing sent
#   live           -> a release verdict is performed. For T4 external writes it
#                     also needs the rung flag below AND a recorded evidence row
COGNOS_AUTONOMY_OUTBOX_MODE=shadow
# Heartbeat wake-up interval for the in-process loop (ms). Only applies on a
# host with a long-lived process (Railway). Serverless uses POST /api/autonomy/tick
COGNOS_AUTONOMY_TICK_MS=60000
# Notice delivery. none (default) records the notice and surfaces nothing, so
# Phase 19 cannot narrate at you until a rung is earned.
#   none     -> record only
#   internal -> in-app notices
#   webhook  -> posts to COGNOS_AUTONOMY_NOTICE_WEBHOOK; with no URL set, the
#               T2 tier is disallowed rather than failing open to nowhere
COGNOS_AUTONOMY_NOTICE_MODE=none
COGNOS_AUTONOMY_NOTICE_WEBHOOK=
# Master switch for the notice channel, independent of where it points.
COGNOS_AUTONOMY_NOTICES=true
# Skill kill switches. Each skill is code, not data; a switch can only remove a
# capability, never grant one.
COGNOS_SKILL_NOTE_APPEND=true
COGNOS_SKILL_EVIDENCE_READ=true
COGNOS_SKILL_MEMORY_SEARCH=true
COGNOS_SKILL_BELIEF_SEARCH=true
COGNOS_SKILL_SOURCE_SNAPSHOT=true
COGNOS_SKILL_NOTE_PROMOTE=true
COGNOS_SKILL_NOTICE_EMIT=true
COGNOS_SKILL_SUBAGENT_SPAWN=true
COGNOS_SKILL_WEB_FETCH=true
COGNOS_SKILL_WEB_SEARCH=true
COGNOS_SKILL_WEBHOOK_POST=true
# --- Phase 20: rung 3 (workers, promotion, evidence fetch) ---
# Sub-agents and promotion requests need the residents rung; web.search needs
# the search rung. web.fetch is gated by the per-goal URL allowlist instead of
# a rung. All default off: unset means the skill refuses with a recorded row.
COGNOS_AUTONOMY_RESIDENTS=false
COGNOS_AUTONOMY_SEARCH=false
# Sub-agent ceilings. A worker's proposed sub-budget is clamped to these; the
# spawn schema caps proposals at 10 steps / $0.25 so clamping stays observable.
COGNOS_SUBAGENT_MAX_STEPS=5
COGNOS_SUBAGENT_MAX_MODEL_CALLS=8
COGNOS_SUBAGENT_MAX_COST_USD=0.10
COGNOS_SUBAGENT_MAX_TOKENS_IN=200000

# --- Phase 21: rung 4 (the first external write) ---
# Rung flag. Built is not enabled: with this off, webhook.post refuses at the
# rung gate, the T4 tier is not allowed, and approving a staged effect answers
# 409 instead of pretending the button did something.
COGNOS_AUTONOMY_EXTERNAL_WRITES=false
# Even with the rung on, a LIVE delivery needs a recorded shadow-evidence row
# (POST /api/autonomy/rungs/external_writes/evidence) whose corpus met the gate.
# Shadow mode needs nothing and delivers nothing — that is how the rung is earned.
COGNOS_AUTONOMY_MIN_SHADOW_SAMPLES=25
# Webhook adapter bounds. A webhook is a trigger, not a message: the body cap is
# small on purpose, and the timeout is short enough that one hung receiver
# cannot eat a whole tick slice.
COGNOS_WEBHOOK_MAX_BODY_BYTES=32768
COGNOS_WEBHOOK_TIMEOUT_MS=8000
COGNOS_WEBHOOK_MAX_REDIRECTS=2
COGNOS_WEBHOOK_MAX_RETRY_DELAY_MS=2000
COGNOS_WEBHOOK_MAX_RESPONSE_BYTES=65536
# Quiet hours, "start-end" in the server's local hour (24h). Applies to EXTERNAL
# deliveries only: a notice is the record of why a goal stopped, so suppressing
# it would hide the thing it exists to report. Unset or malformed = never quiet.
COGNOS_AUTONOMY_QUIET_HOURS=
# The signing secret is referenced BY NAME from a goal's step (secret_ref) and
# resolved at send time. Only the name is ever stored. Define your own, e.g.:
# COGNOS_WEBHOOK_SIGNING_KEY=...   (never committed; pin.secrets_env_only)

# Grace window (ms) for the self-hosted SIGTERM handler: stop the heartbeat,
# let the in-flight tick park and release its lease, close the pool.
COGNOS_SHUTDOWN_GRACE_MS=25000
