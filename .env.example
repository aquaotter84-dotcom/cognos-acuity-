# ---------------------------------------------------------------------------
# COGNOS environment. On Vercel set these in Project -> Settings -> Environment
# Variables. Never commit real values; none of these reach the browser.
# ---------------------------------------------------------------------------

# --- Model: BluesMinds (required) ---
# Create a key at https://api.bluesminds.com/console -> Tokens (starts with sk-)
BLUESMINDS_API_KEY=sk-...
# Optional. OpenAI-compatible base URL. Default: https://api.bluesminds.com/v1
BLUESMINDS_API_URL=https://api.bluesminds.com/v1
# Optional. Defaults to gpt-4o-mini. gpt_5_4 is REFUSED by the app (503s on this account).
COGNOS_MODEL=gpt-4o-mini
# Optional cheaper model for Observer/Strategist/Critic/memory. Defaults to COGNOS_MODEL.
COGNOS_FAST_MODEL=gpt-4o-mini
# Optional. One logical deadline for an upstream call INCLUDING retries.
# Clamped to 1–180 seconds; default 60000.
COGNOS_LLM_TIMEOUT_MS=60000
# Optional. Retry transient network/408/429/5xx gateway failures with the exact
# same prompt and model. Clamped to 0–2; default 1. Retries stay inside the
# logical deadline above, and every physical attempt is recorded in telemetry.
COGNOS_LLM_MAX_RETRIES=1
# Optional transport-only tuning. Leave blank unless the configured compatible
# gateway supports these Chat Completions fields. They never change prompts or
# models. OpenAI supports auto/default/flex/scale/priority/fast service tiers.
COGNOS_LLM_SERVICE_TIER=
# Optional provider routing key for exact-prefix prompt caching (max 64 chars).
# This is an identifier, not a credential; never put sensitive data in it.
COGNOS_PROMPT_CACHE_KEY=

# --- Database: Neon (required for persistence) ---
# Neon dashboard -> Connection string -> "Pooled connection".
# MUST be the pooled postgres:// URL containing "-pooler". The REST https://
# variant is rejected by the app (it hangs ~16s per query).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cognos?sslmode=require

# --- Web search (optional) ---
# With no key the council falls back to DuckDuckGo (keyless).
TAVILY_API_KEY=
COGNOS_SEARCH_ENABLED=true

# --- Phase 14/15 subsystems (all optional; defaults shown) ---
# Event ledger kill switch. false = no knowledge_events rows are written at all.
COGNOS_LEDGER_ENABLED=true
# Coherence monitor: one extra cheap-model call per turn that measures the draft
# against stored beliefs. false = the stage is skipped.
COGNOS_COHERENCE_ENABLED=true
# Reasoning telemetry: one record per run (latency, model, tokens, cost, veto,
# failures). false = nothing is written to telemetry_runs.
COGNOS_TELEMETRY_ENABLED=true
# Adaptive orchestrator mode. v1 forces "observe": "auto" is recorded as
# requested and refused (law phase15.observe_only). No live strategy switches.
COGNOS_ADAPTIVE_MODE=observe

# --- Phase 17/18 sources, images, research + bounded agent (optional) ---
# Document/link/image ingestion. false removes source reads from council context
# and disables the source API without deleting immutable snapshots already stored.
COGNOS_SOURCES_ENABLED=true
# Raw upload/fetch and extracted-text safety limits. Server clamps out-of-range
# values; the browser upload surface currently caps files at 6 MB as well.
COGNOS_SOURCE_MAX_BYTES=4000000
COGNOS_SOURCE_MAX_TEXT_CHARS=750000
COGNOS_LINK_MAX_BYTES=2000000
COGNOS_LINK_TIMEOUT_MS=12000
# Phase 18 images: PNG/JPEG/WebP originals are always parsed and hashed. The
# Image Desk vision reading (region-boxed transcript, injection screening) is
# on unless disabled; COGNOS_IMAGE_MODEL defaults to the primary model.
COGNOS_IMAGE_MAX_BYTES=4000000
COGNOS_IMAGE_VISION_ENABLED=true
COGNOS_IMAGE_MODEL=
# Phase 18 research mode: proposes a finite read-only plan that executes only
# after the user approves each step (recorded in agent_approvals).
COGNOS_RESEARCH_ENABLED=true
COGNOS_RESEARCH_MAX_STEPS=3
# Agent mode remains explicit per turn (off / observe / read_only / research).
# This switch disables the non-off modes. Phase 17/18 have no autonomous
# write-capable tools and research never releases an answer by itself.
COGNOS_AGENT_ENABLED=true

# --- Optional access gate ---
# Unset = no gate, app opens straight to chat. Set = visit /gate?key=<value> once.
COGNOS_RUNTIME_SECRET=

# Local only. Vercel sets its own port.
PORT=3000
